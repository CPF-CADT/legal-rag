TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
LLM_BACKEND=gemini
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_MAX_TOKENS=
OPENROUTER_TIMEOUT=180
OPENROUTER_REASONING_ENABLED=true
GEMINI_API_KEYS_FILE=apps/api/secrets/gemini_api_keys.txt
GEMINI_MODEL=gemini-3.8-flash
# Optional. Leave empty to use the model's default output limit.
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_BACKEND=macos_app
GEMINI_APP_NAME=Gemini
GEMINI_APP_TIMEOUT=900
GEMINI_RESPONSE_STABLE_SECONDS=4
LEGALRAG_HOST=127.0.0.1
LEGALRAG_PORT=8000
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=low
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_SECONDS=1
DENSE_RETRIEVAL_MIN_SIMILARITY=0.35
DENSE_RETRIEVAL_NEIGHBOR_COUNT=1
LEGALRAG_LOG_FULL_CONTENT=false
LEGALRAG_API_KEY=
LEGALRAG_MAX_QUERY_LENGTH=4000
LEGALRAG_RATE_LIMIT_PER_MINUTE=0
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
HF_TOKEN=replace_with_huggingface_access_token
