# Existing local rule
.ev
# Python cache and build files
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and local configuration
.env
apps/telegram-bot/logs/
apps/telegram-bot/secrets/*.txt
apps/telegram_bot/logs/
apps/telegram_bot/secrets/*.txt
apps/api/secrets/*.txt
apps/telegram-bot/.env
apps/telegram-bot/telegram_bot.pid
apps/telegram_bot/.env
apps/telegram_bot/telegram_bot.pid
!bot/secrets/gemini_api_keys.txt.example
.env.*
!.env.example
.edds
*.local

# Jupyter and tool caches
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Project-generated files
data/
keys.txt
ncdd_laws/
ncdd_ocr/
ncdd_ocr_pipeline/
ncdd_ocr_khmerocr/
ncdd_ocr_netra/
ncdd_ocr_gemini/
ncdd_ocr_openai/
ncdd_ocr_tesseract/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
apikey.txt
temp/
