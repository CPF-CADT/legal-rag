# Terraform provider cache
.terraform/

# Terraform state and backups
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Local variable files may contain environment-specific values
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
*.plan

# Keep .terraform.lock.hcl tracked for reproducible provider versions.
